def key_elite(key, x, y):
    if key == GLUT_KEY_LEFT:
       clickbuttons['left'] = True
    elif key == GLUT_KEY_RIGHT:
       clickbuttons['right'] = True


def key_upelite(key, x, y):
    if key == GLUT_KEY_LEFT:
       clickbuttons['left'] = False
    elif key == GLUT_KEY_RIGHT:
       clickbuttons['right'] = False


