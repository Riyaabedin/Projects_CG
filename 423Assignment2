def trapsketch():
    if currn == pausing__here:
        glColor3f(1.0, 0.0, 0.0)  
    else:
        glColor3f(1.0, 1.0, 1.0) 

    x, y = traaap_x, traaap_y
    w, h = traaap_WIDTH, traaap_HEIGHT

    mpld(x, y + h, x + 10, y)
    mpld(x + 10, y, x + w - 10, y)
    mpld(x + w - 10, y, x + w, y + h)
    mpld(x, y + h, x + w, y + h)


def draw_Rombusangle():
    if currn == pausing__here:
        return

    glColor3f(Rombusangle_color[0], Rombusangle_color[1], Rombusangle_color[2])
    x, y = Rombusangle_x, Rombusangle_y
    w, h = Rombusangle_WIDTH, Rombusangle_HEIGHT
    mpld(x + w / 2, y + h, x, y + h / 2)
    mpld(x, y + h / 2, x + w / 2, y)
    mpld(x + w / 2, y, x + w, y + h / 2)
    mpld(x + w, y + h / 2, x + w / 2, y + h)


